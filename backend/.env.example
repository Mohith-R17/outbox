PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public"
REDIS_URL="redis://localhost:6379"

# SMTP (Ethereal or Sendgrid etc)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER="ethereal_user"
SMTP_PASS="ethereal_pass"

# Rate Limiting & Concurrency Config
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR=3

# Elasticsearch
ELASTICSEARCH_URL="http://localhost:9200"

# Slack OAuth
SLACK_CLIENT_ID="your_slack_client_id"
SLACK_CLIENT_SECRET="your_slack_client_secret"
SLACK_REDIRECT_URI="http://localhost:3000/api/slack/callback"
